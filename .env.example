# Copie para .env e preencha UMA das opções abaixo.

# --- Opção 1 (padrão): Anthropic Claude, SDK oficial
# Chave em https://console.anthropic.com/settings/keys
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Profundidade de raciocínio: low | medium | high (low basta para atendimento)
LLM_EFFORT=low

# --- Opção 2: qualquer API compatível com OpenAI (troque LLM_PROVIDER para "openai")
# Google Gemini — camada gratuita: https://aistudio.google.com/apikey
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
#
# OpenAI:  LLM_BASE_URL vazio, LLM_MODEL=gpt-4.1-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.3-70b-versatile
# Ollama:  LLM_API_KEY=ollama, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2

# Opcional: fixa a data/hora "atual" (ISO 8601) para reproduzir exemplos/testes.
# EMPORIO_AGORA=2026-03-24T10:30
