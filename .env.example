# Qualquer provedor com API compatível com OpenAI (chat completions + tools).
# Copie para .env e preencha UMA das opções abaixo.

# --- Google Gemini (tem camada gratuita: https://aistudio.google.com/apikey)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# --- OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_MODEL=gpt-4.1-mini

# --- Groq (camada gratuita: https://console.groq.com/keys)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Ollama local (sem chave; use um modelo com suporte a tools, ex.: qwen2.5:7b)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2

# Opcional: fixa a data/hora "atual" (ISO 8601) para reproduzir exemplos/testes.
# EMPORIO_AGORA=2026-03-24T10:30
